# Pilot defaults. Never commit a real secret in this file.
CITRUS_ENV=development
CITRUS_AUTH_REQUIRED=true
# Empty uses the default [auth] provider in secrets.toml.
CITRUS_AUTH_PROVIDER=
CITRUS_DEFAULT_ORGANIZATION=柑橘产业链试点
CITRUS_DATABASE_URL=sqlite:///./.runtime/pilot.db
CITRUS_RUNTIME_DIR=./.runtime
CITRUS_BLOB_BACKEND=local
CITRUS_BLOB_DIR=./.runtime/attachments
# Production: use an S3-compatible bucket and a malware scanner.
# CITRUS_DATABASE_URL=postgresql+psycopg://user:password@host:5432/citrus
# CITRUS_BLOB_BACKEND=s3
# CITRUS_S3_BUCKET=citrus-private-files
# CITRUS_S3_ENDPOINT=https://oss-cn-xxx.aliyuncs.com
# CITRUS_CLAMAV_HOST=clamav
# CITRUS_CLAMAV_PORT=3310

# Local-only fallback. Keep false on any public deployment.
CITRUS_DEV_AUTH_ENABLED=false
